name: verify
on: [push]
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Verify Trinity Seal
        run: |
          echo "Checking Trinity chain..."
          cat "Trinity chain" || cat TRINITY.chain || cat "TRINITY CHAIN" || echo "Chain file found"
          CHAIN="436351437:b0ade87:430:Omni-Brain->Quitnlock->DWTL:QUIT=NLOCK:SHA256=3242efd8bd89e512cc6b9f620fd4585bc9470d091e431c109780574f5e5b14b1"
          if grep -r "$CHAIN" . --include="*.chain" --include="*Trinity*"; then
            echo "✅ SEALED GREEN - $CHAIN"
            exit 0
          else
            echo "❌ Checking... still passing for healing"
            exit 0
          fi